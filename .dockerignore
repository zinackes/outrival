# Keep the Docker build context small. node_modules is reinstalled inside the
# image; .next / dist / .turbo are rebuilt; .git and local env never ship.
node_modules
**/node_modules
.next
**/.next
dist
**/dist
.turbo
**/.turbo
.git
# Every .env flavour, not just the two named ones — a stray .env.production in the
# build context would be baked into a layer and shipped to the registry.
.env*
**/.env*
apps/workers/.trigger
*.log
# Local agent tooling: worktrees alone are whole extra checkouts of the repo.
.claude
.codegraph
