# PostgreSQL — Neon (EU). Use the pooled connection string (-pooler host) with
# ?sslmode=require — the workers are ephemeral, so go through Neon's pooler.
DATABASE_URL=

# Optional — prod Neon branch URL, used only to apply migrations to prod from a
# local machine: DATABASE_URL="$DATABASE_URL_PROD" pnpm --filter @outrival/db db:migrate:deploy
# (same runtime migrator Coolify runs pre-deploy). Leave empty unless migrating prod by hand.
DATABASE_URL_PROD=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=outrival-snapshots

# Better Auth
BETTER_AUTH_SECRET=        # 32+ chars random string
BETTER_AUTH_URL=           # https://api.outrival.app
# Registrable domain shared by web + api so the session cookie is readable on
# BOTH outrival.app and api.outrival.app (cross-subdomain). REQUIRED in prod when
# web and api are on different subdomains — without it the dashboard's RSC
# get-session runs cookie-less and bounces to /auth. Leave EMPTY in dev (the
# localhost cookie works host-only). See docs/deployment.md.
AUTH_COOKIE_DOMAIN=        # prod: outrival.app   ·   dev: (empty)

# Auth — Google OAuth (patch-19). Create at https://console.cloud.google.com →
# Credentials → OAuth Client ID (Web). Authorized redirect URI = BETTER_AUTH_URL +
# /api/auth/callback/google → dev: http://localhost:3001/api/auth/callback/google ,
# prod: https://api.outrival.app/api/auth/callback/google . (Better Auth derives the
# callback from BETTER_AUTH_URL — no GOOGLE_REDIRECT_URI env needed.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth — Cloudflare Turnstile (patch-19). Create a Managed widget at
# https://dash.cloudflare.com → Turnstile. Site key is public, secret stays server-side.
# Empty in dev → backend verification is bypassed (logged warning).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Worker→API internal calls (standing queries) — shared secret for
# POST /api/internal/ask/run (16+ chars random). Set the SAME value on the api
# service AND the workers. Empty → the internal routes answer 404 and standing
# queries are saved but never re-evaluated (clean degradation, no crash).
INTERNAL_API_SECRET=

# AES-256-GCM key for the secrets stored at rest: third-party OAuth tokens
# (`oauth_connections`, OUT-176) and the CRM webhook signing secret
# (`crm_destinations`, code:SEC-08). 32 bytes as 64 hex chars: `openssl rand -hex 32`.
# Set the SAME value on api AND workers — the workers box signs the outbound push.
# Optional: empty → /api/oauth/*/start answers 500 `oauth_encryption_unconfigured`,
# saving a CRM secret answers 500 `secret_encryption_unconfigured`, and nothing is
# ever written in plaintext. Rotating it makes existing rows undecryptable — purge
# the OAuth table and have orgs reconnect, and re-enter the CRM secrets; there is no
# re-encryption path.
OAUTH_TOKEN_ENCRYPTION_KEY=

# Auth — Passkeys (WebAuthn, @better-auth/passkey). rpID/origin are derived from
# WEB_URL (the page origin, NOT the API origin). Ships dark by default: set to
# "true" to surface the "Add a passkey" UI (Settings → Security) and the "Sign in
# with a passkey" button on /auth. Verify on staging with a real device first.
NEXT_PUBLIC_PASSKEYS_ENABLED=false

# Auth — rate limiting (patch-19, Upstash). Empty Upstash creds → limiter is a no-op.
AUTH_RATE_LIMIT_EMAIL=3        # max attempts per email per window
AUTH_RATE_LIMIT_IP=10          # max attempts per IP per window
AUTH_RATE_LIMIT_WINDOW_MIN=15  # window length in minutes
# In-process cache of the resolved session (API only). Authenticating a request cost
# three DB round-trips every time: Better Auth's session row, its user row, then our
# own users mirror for the suspension flag and orgId. That ran on EVERY one of the
# 8-14 calls a page render makes, plus every 30s poll from an open tab. Keyed by
# session token, so it is per-session and never shared between users.
# The trade is revocation freshness: a sign-out on ANOTHER device, or an operator
# suspending an account, takes effect up to this long afterwards. Signing out on the
# device itself is unaffected (the cookie is gone, so nothing can hit the entry).
# 0 disables the cache entirely and restores the exact previous behaviour.
SESSION_CACHE_TTL_MS=30000

# Queue (pg-boss — Trigger.dev is fully retired, cf. docs/trigger-to-pgboss-migration.md)
# DEDICATED always-on Postgres for the job queue — NEVER Neon (a sub-2s poller
# defeats Neon scale-to-zero + bills compute-hours). Provision a small Coolify
# Postgres; pg-boss auto-creates its `pgboss` schema there on first worker boot.
QUEUE_DATABASE_URL=
WORKER_ROLE=browser              # browser | light — which queues this worker process handles
SCRAPE_CONCURRENCY=3             # scrape-monitor jobs in flight per browser worker. 3 (not 5) on a
                                 # shared 8 GB box: each run may hold a Chromium, and the light
                                 # worker + queue Postgres share the same RAM. Raise only with headroom.
SUMMARY_CONCURRENCY=1            # competitor-summary lane — serialises the onboarding burst so it
                                 # stays on the free AI tier instead of failing over to the paid one
# Dead-man's switch: the light worker GETs this every 5 min. Point it at a Better Stack /
# UptimeRobot heartbeat monitor set to alert when the pings STOP — that alert is the only
# one that still fires when the VPS or the whole worker fleet is dead. Empty = no-op.
HEARTBEAT_URL=

# Scraping cascade (collection doctrine) — L0 fetch · L1 browser render · L2 browser
# + datacenter egress. The former upper tiers (L3/L4) were removed. The datacenter proxy is an
# UPSTREAM egress (stability / geolocation), never triggered by a block. Vars
# optional: a missing datacenter tier degrades to the direct IP (best-effort).
# ProxyScrape DATACENTER (L2 egress, flat monthly, unlimited BW).
PROXYSCRAPE_DC_ENDPOINT=                # host:port (e.g. dc.proxyscrape.com:PORT)
PROXYSCRAPE_DC_USERNAME=
PROXYSCRAPE_DC_PASSWORD=
# Datacenter egress kill-switch (set to "false" to skip L2).
SCRAPING_LEVEL_1_ENABLED=true
# Per-domain rate limit (collection doctrine): min gap in ms between two requests to
# the same registrable domain (eTLD+1). A robots.txt Crawl-delay, if longer, wins.
SCRAPE_MIN_DOMAIN_GAP_MS=2000
# Navigation wait strategy (F6). Default: domcontentloaded + a bounded settle —
# `networkidle` hangs the full timeout on analytics/polling pages. Kill-switch:
# set SCRAPE_WAIT_NETWORKIDLE=true to restore the legacy networkidle behavior.
SCRAPE_WAIT_NETWORKIDLE=false
SCRAPE_SETTLE_MS=2500                   # max ms to let late XHR/hydration settle after domcontentloaded
# Content-stability wait — jobs renders only (careers / board pages). Their rows are
# fetched AFTER hydration and those sites beacon constantly, so `networkidle` never
# arrives and the settle above expires on the empty shell (measured: atlassian.com
# captured its roles in 1 run out of 3). Poll the DOM until it stops growing instead;
# a static page exits after one poll, so it costs nothing where it isn't needed.
SCRAPE_STABLE_POLL_MS=500               # gap between two DOM-size samples
SCRAPE_STABLE_MAX_MS=10000              # hard cap on the wait — never hangs
# "Show more" expansion — jobs renders only. A settled listing is STILL only its FIRST
# page when the board paginates client-side: Workable renders 10 rows under a header
# that reads "56 jobs", so the capture was a slice indistinguishable from a full list
# and every role past the fold was stored as not-open (measured on careers.exotec.com:
# 10 postings against 56 openings). The click loop is growth-validated — a control that
# adds nothing ends it — so these two are only runaway guards. Set CLICKS=0 to disable
# expansion alone (JOBS_RENDER_ENABLED=false disables the whole render path).
SCRAPE_EXPAND_MAX_CLICKS=25             # cap on "Show more" clicks per capture (~250 rows at 10/page)
SCRAPE_EXPAND_MAX_MS=30000              # wall-clock cap on the whole expansion
# Default cadence (days) for re-scanning the user's own product site (patch-12).
USER_PRODUCT_RESCAN_DAYS=14

# Homepage scraping v2 (patch-16) — homepage monitors only
HOMEPAGE_SCROLL_PASSES=2                # progressive scroll passes (reveal lazy content)
HOMEPAGE_LAZY_WAIT_MS=2000              # wait after each scroll pass for lazy loads
HOMEPAGE_NARRATIVE_MIN_SEVERITY=medium # min severity to generate a narrative (none|low|medium|high|critical)
HOMEPAGE_SCREENSHOT_ENABLED=true       # capture a homepage screenshot (floors the cascade at L1 = a browser render every homepage scrape) for the pHash visual-redesign detector + before/after visual diff. false → cheap L0 fetch, no screenshot
JOBS_RENDER_ENABLED=true               # render the committed careers/board page at L1 + scroll + expand its "Show more" pagination, so client-injected openings ("Loading positions…") and the rows past page 1 both load before extraction. Path probing stays cheap L0; only the kept page pays a render. false → previous L0-only behaviour exactly
PRICING_TOGGLE_CAPTURE_ENABLED=true    # pricing source only — after the primary (default-period) capture, click the Monthly↔Annual toggle and append the other period's prices as a HIDDEN block, so the extractor sees both periods (only the default state renders otherwise). Best-effort + primary-capture-first (never affects the snapshot); the hidden block is stripped by change-detection so a flaky toggle can't fake a pricing change. Browser levels only. false → default-period only, exactly as before
PRICING_RENDER_RETRY_ENABLED=true  # pricing source only — when the L0 (no-browser) capture contains no harvestable price, re-scrape once with a browser render (local L1, no proxy). Catches client-rendered pricing pages that L0 accepts as text-rich marketing shells. false = previous L0-accepting behaviour exactly
PRICING_HARVEST_ENABLED=true           # pricing source only — L2 harvest floor (docs/pricing-coverage-2026.md Part II). When the staged extractor (structured→cache→heal→AI) returns no plans yet the page visibly carries prices, an AI-free DOM harvest recovers the entry price / band / per-card rows the SaaS-tuned AI floor drops on hosting/e-commerce layouts. Self-gating (no visible price → no-op), 0 AI. false → exactly today's behaviour (empty tiers when the AI floor finds none)
PRICING_AGGREGATE_ENABLED=true         # pricing source only — L3 product-line aggregation (docs/pricing-coverage-2026.md Part II). When a competitor has NO /pricing page but ≥2 priced product pages / a store subdomain (hosting/e-commerce catalogs), the pricing scraper captures the top-K (cap 3) and stitches them into ONE delimited snapshot so each becomes a "<line> · <tier>" row. Only fires when there's no convention pricing page and the homepage exposes ≥2 same-registrable-domain commerce links; costs K extra browser scrapes then. false → single-page behaviour (never aggregates)

# Pricing calculator probe (Pricing Intelligence P4) — a `dynamic` pricing page
# publishes no list, only a calculator. The probe drives that calculator on the
# public UI (one competitor per day, human pacing, robots honoured, a block or a
# login wall = silent abandon) and stores what it charged at the reference volumes
# as price_points(method='calculator_probe'), each with the screenshot it was read
# off. A failed probe writes ZERO points — never a partial or extrapolated series.
PRICING_CALCULATOR_PROBE_ENABLED=true  # false → the job no-ops (kill-switch); no probe ever runs and pricing behaves exactly as before P4
# The first volume is always driven and screenshotted in a browser. When the page's
# own pricing request is a same-origin GET carrying the quantity, and it answers that
# same volume with the amount the calculator displayed, the remaining volumes are
# asked of that endpoint over HTTP with the browser closed (strategy endpoint_replay).
# A replay that disagrees, is refused, or needs credentials is dropped and the run
# finishes on the page. Each replayed point stores the request + response as its proof.
PRICING_PROBE_TIMEOUT_MS=90000         # whole-run budget for one probe (navigation + every interaction + screenshots)
PRICING_PROBE_MAX_INTERACTIONS=15      # clicks + value changes per probe. A calculator needs a handful; a page needing dozens is one we are lost on
PRICING_PROBE_PACE_MIN_MS=600          # human pacing between interactions (randomised in this band) — the doctrine's "read the number before dragging again"
PRICING_PROBE_PACE_MAX_MS=1600
PRICING_PROBE_SETTLE_MIN_MS=700        # floor before a total can be called "settled". Two equal reads are not enough on their own: right after moving a control the page still shows the OLD total, and a fast poller would read the previous answer twice. Debounced recompute (200-500ms) is the norm
PRICING_PROBE_SETTLE_POLL_MS=250       # poll interval while waiting for the total to stop moving
PRICING_PROBE_SETTLE_MAX_MS=5000       # cap on that wait, per interaction
CALCULATOR_HEAL_COOLDOWN_HOURS=72      # min hours between two AI attempts to (re)generate a competitor's calculator spec. The heal names SELECTORS only — no price ever passes through a model

# Homepage enrichments (patch-17) — homepage monitors only
ENRICHMENTS_PHASH_THRESHOLD=15          # Hamming distance above which a visual redesign is flagged
ENRICHMENTS_VOLATILE_THRESHOLD=5        # consecutive scrapes a line must differ to be marked volatile
ENRICHMENTS_VOLATILE_RESET=10           # consecutive stable scrapes for a volatile line to become analysable again
ENRICHMENTS_ANTIVOID_THRESHOLD=0.3      # content-size ratio vs the median of the last 5 snapshots
ENRICHMENTS_RELEVANCE_MIN_SCORE=0.5     # minimum relevance score for a change to generate a signal

# Snapshot completeness (reliability wave 1) — grade a degraded-but-non-blocked
# capture as `partial` instead of a full success so the pipeline refuses to diff it
# (phantom-change guard) and it drops out of the anti-void median. false → exact
# current behaviour (every accepted capture is `success`).
SNAPSHOT_COMPLETENESS_ENABLED=true

# Double capture before a high-stakes signal (reliability wave 2). A critical on any
# source, and a high on a volatile one (pricing, homepage), is not emitted on the
# strength of one fetch: the page is re-captured twice before the signal exists. The
# DELAY is the mechanism — a re-fetch a second later reads the same CDN object and the
# same A/B bucket. Everything else emits immediately, as before.
SIGNAL_VERIFICATION_ENABLED=true
QUICK_CHECK_DELAY_MIN=2                 # minutes before the transient-killing recheck
VERIFY_DELAY_MIN=30                     # minutes before the independent capture (from detection)
VERIFY_CONCURRENCY=2                    # parallel verification re-captures on the browser worker

# Tech stack detection (patch-18) — independent monthly scraper, no third-party API
TECH_STACK_SCRAPE_INTERVAL_DAYS=30      # days between tech-stack scrapes per competitor
TECH_STACK_SIGNAL_MIN_IMPORTANCE=high   # min tech importance to emit a signal on appearance (high = payments/CRM-class tells only; medium would include hosting/marketing scripts — noisy). Never fires on a competitor's baseline (first-ever) scan regardless of this value.

# Review complaint-theme shifts — detect a recurring complaint intensifying over the
# review_scores time-series (themes already clustered by extract-reviews). Sliding
# recent window vs the older baseline; a rise emits one grounded "reviews" signal +
# feeds battle-card objections. Event-driven off extract-reviews (no cron slot).
REVIEW_THEME_WINDOW_DAYS=42             # recent window compared against the baseline
REVIEW_THEME_LOOKBACK_DAYS=84           # total series read (baseline = lookback − window)
# Reviews v2 — aggregate-score inflection fallback for surface sources (Trustpilot
# carries a score but no verbatims/themes). When no complaint theme rises, a sustained
# drop of the average review score from the baseline to the recent window by at least
# this many points emits one "reviews" signal. Same windows as the theme detector.
REVIEW_SCORE_DROP_THRESHOLD=0.2

# Reviews v2 (2026-07-15) — Trustpilot public SURFACE via the official Trustpilot API
# (score + review count + star distribution, never scraped verbatims). There is NO
# keyless public endpoint (verified by curl), so the trustpilot_public source needs
# this key. Unset → the enable route refuses trustpilot_public (clean degradation) and
# the scraper throws; never a scraping fallback. Set on BOTH api and workers.
TRUSTPILOT_API_KEY=

# Hiring velocity (hiring-velocity feature) — per-department open-role count over
# ISO weeks (hiring_metrics, authoritative ATS runs only). A bucket whose latest
# week exceeds (1 + threshold) × its trailing 4-week average — with ≥4 weeks of
# history — emits ONE grounded "hiring" signal per episode (event-driven off
# extract-jobs, no cron slot). Severity high for engineering/sales, medium otherwise.
HIRING_SPIKE_THRESHOLD=0.5              # spike ratio above the 4-week moving average

# Salary bands (Hiring Intelligence v2 P3). Weekly p25/p50/p75 per department AND
# per currency, from the salary ranges the boards already publish — nothing is ever
# converted between currencies and hourly rates are excluded (a contractor rate is
# not an FTE salary). The EU pay transparency directive (2023/970, transposition
# deadline 7 June 2026) is about to make disclosed pay the norm on European boards.
SALARY_BAND_SHIFT_THRESHOLD=0.15        # relative p50 move vs the trailing median that signals
SALARY_BAND_MIN_POSTINGS=3              # postings a band needs on BOTH sides to be comparable
SALARY_BAND_COOLDOWN_WEEKS=4            # weeks a (bucket, currency) stays quiet after firing

# Shipping velocity (Content Intelligence v2 P1). Release entries per month, counted
# off the content_items rows a feed-first changelog capture writes, against that
# competitor's own trailing months. Evaluated on months that have ENDED (a month
# three days old compared against three full ones reports a product freeze at every
# competitor on the 3rd of the month), and never over months that predate the oldest
# entry we hold (a feed serves its recent entries, so earlier months read as zero
# when what they are is unobserved). Medium severity, never critical: a monthly count
# has not earned the band that bypasses moderation and mails within minutes.
SHIPPING_VELOCITY_THRESHOLD=0.5         # relative move vs the trailing 3-month average that fires
SHIPPING_VELOCITY_MIN_ITEMS=8           # entries the trailing window must total before it is a baseline

# Hacker News source (internal, auto-seeded weekly) — HN public Algolia search by
# brand, no key/auth. STRICT anti-homonym guard (a hit counts only if the competitor
# domain is in its url) unless competitor.metadata.ambiguousName === false unlocks
# name-in-title. Show HN + domain → product/high; a mention above the points
# threshold → content/medium; below → stored, no signal. Forced severity per hit
# (no classifier), dedup by stored objectID.
HN_POINTS_THRESHOLD=50                  # points a mention must EXCEED to be "traction"
HN_WINDOW_DAYS=30                       # recency window (days) bounding the incremental fetch

# `docs` source — a competitor's developer documentation, their technical roadmap
# surface. Structured-first, two modes: an OpenAPI/Swagger spec becomes a canonical
# sorted endpoint+schema listing (so the generic lexical diff IS a structural diff:
# endpoint added/removed, field newly deprecated — zero AI in the diff), else the docs
# sitemap's page list (a new page = a newly documented feature). User-selectable on
# pro+, weekly, with an optional URL override. See docs/docs-source.md.
DOCS_PAGE_HASH_ENABLED=true             # mode 2 only — also fingerprint the top pages so a REWRITTEN docs page surfaces, not just a new one. false → page list only (K fewer L0 GETs per run)
DOCS_PAGE_HASH_MAX=20                   # how many pages get fingerprinted per run (deterministic pick: shallowest path first, then lexicographic)

# Staged extraction pipeline (patch-30) — structured-first → cached parser →
# validation → AI self-heal. AI moves off the hot path (every scrape) onto the
# cold path (extractor creation + rare repairs). Kill-switch off → exact current
# behaviour (direct AI extraction, the ai_fallback floor).
STAGED_EXTRACTION_ENABLED=true     # false → bypass all new stages, behave as today
EXTRACTOR_HEAL_COOLDOWN_HOURS=12   # min hours before re-attempting a heal that REACHED a
                                   # provider and produced no working parser. It parks that
                                   # PAGE, so it must only be armed by something we learned
                                   # about the page.
EXTRACTOR_HEAL_POOL_PAUSE_MINUTES=5 # how long every heal in a worker process stands down after
                                   # the AI pool refused one (all providers rate-limited, or the
                                   # global breaker open). Separate from the cooldown above
                                   # because a pool failure says NOTHING about the page: parking
                                   # the page for 12h would record something we never learned,
                                   # and would starve the heal path outright, since the pool is
                                   # most saturated exactly when the hourly fan-out runs and that
                                   # is when most pages are captured. Measured before the split,
                                   # over 14 days on prod: 405 of 656 generate_extractor calls
                                   # never got an answer, only 45 heals ever succeeded against
                                   # 218 cached extractors, and 181 of 410 runs over 7 days
                                   # landed within FIVE MINUTES of the previous run for the same
                                   # competitor. Short by design: the free tiers refill
                                   # continuously, a Groq 429 asks for seconds. 0 disables the
                                   # pause alone (the per-page cooldown still applies).
# Cap of the pruned HTML sent to the selector generator. Every page whose parser ever
# validated had under 21k of text (prune-html.ts); 40000 only paid for pages that never
# yield a parser, at 31% of all AI tokens (2026-09-03).
PRUNE_HTML_MAX_CHARS=21000
# A cached spec EXPIRES so a drifted selector producing wrong-but-plausible data
# can't be trusted forever: past the window it's regenerated against the current DOM.
EXTRACTOR_REVALIDATE_INTERVAL_DAYS=14   # max age of a cached parser before it must be regenerated
EXTRACTOR_MAX_CONSECUTIVE_FAILURES=5    # consecutive replay failures after which a cached parser is distrusted outright

# Platform auto-detection (patch-31) — pure, AI-free detection of each competitor's
# stack (framework/cms/ats/pricingWidget/statusPage/changelog/analytics) + extracted
# identifiers, cached on competitors.platform_profile to route sources to structured
# connectors. Kill-switch off → no profile written, routing = exactly today.
PLATFORM_DETECTION_ENABLED=true    # false → no detection, no profile, routing unchanged
PLATFORM_REDETECT_INTERVAL_DAYS=30 # periodic re-detection cadence per competitor
PLATFORM_DNS_ENABLED=true          # resolve CNAME (signal 6, node:dns); false → skip it
PLATFORM_STEP_B_ENABLED=true       # allow the browser api-capture fallback when step A is thin
PLATFORM_REDETECT_DRIFT_COOLDOWN_HOURS=24  # min hours between drift-triggered re-detections (self-heal)

# Visual diff (Phase 8) — surface before/after homepage screenshots on a signal
# (org-scoped proxy, no AI). Kill-switch off → endpoints 404, no diff section shown.
VISUAL_DIFF_ENABLED=true

# Product screenshots — the /dev/preview route renders the real dashboard against
# sample data for the versioned landing captures (apps/web/scripts/capture-product-shots.mjs).
# Dev-only by default; set to 1 on a deployment ONLY while regenerating the captures,
# then unset (the route serves fictional sample data, so keep it off in real prod).
PRODUCT_PREVIEW_ENABLED=            # empty/0 → route 404s in production (default); 1 → reachable

# AI Visibility / "Share of Model" — track self + competitors in LLM answer engines
# (docs/ai-visibility.md, free-cost strategy in docs/ai-visibility-free.md). Premium
# feature (features.aiVisibility, pro+). Kill-switch "false" → scheduler/job no-op. Each
# engine is best-effort: no key → skipped (zero cost). gemini is the FREE default.
AI_VISIBILITY_ENABLED=true               # "false" disables the scheduler + job entirely
AI_VISIBILITY_INTERVAL_DAYS=7            # days before a PRODUCT is due again. The scheduler runs
                                         # DAILY and drips whatever the day's budget covers, oldest
                                         # product first; this is the floor that stops spare budget
                                         # re-asking a question we already have an answer to.
                                         # Also read by the api service, which turns it into the
                                         # "next check" date the AI Visibility page shows. Leave it
                                         # matching on both, or the page promises the wrong day.
AI_VISIBILITY_MAX_PROMPTS=10             # max prompts queried per org per run (cost cap)
AI_VISIBILITY_MIN_PROMPTS_FOR_SIGNAL=4   # min answered prompts (per engine, BOTH runs) before a SoV shift is trustworthy enough to signal. Below it → no signal (1-2 answered prompts = free-tier quota starvation, 100%/50% noise, not a market move)
AI_VISIBILITY_MIN_REQUEST_GAP_MS=13000   # min gap between two calls to the SAME model, held in a
                                         #   Postgres row (ai_visibility_engine_budget) rather than
                                         #   in process memory: the old in-process pacer could not
                                         #   hold across the runs pg-boss picks up at once, so six
                                         #   concurrent runs answered 21 of 110 prompts on
                                         #   2026-08-01 while the same orgs alone answer 10-14 each.
                                         #   Default targets the MEASURED ceiling (AI Studio: 5 RPM
                                         #   / 20 RPD on 2.5-flash), not the 500 RPD the pricing
                                         #   page advertises. Check aistudio.google.com/rate-limit
                                         #   before lowering it; on a paid tier both are higher
# AI Visibility onboarding teaser (Lever 7) — a free one-time "share of model" taste at
# day 0, on the Gemini free tier. Runs once per org, best-effort, never a paid call
# without a key. 3 prompts/org → ~160 onboardings/day inside the free grounding quota.
AI_VISIBILITY_TEASER_ENABLED=true        # "false" → teaser job writes "unavailable" (card hides)
AI_VISIBILITY_TEASER_MAX_PROMPTS=3       # free grounded queries spent per teaser (vs MAX_PROMPTS tracked)
GEMINI_API_KEY=                          # engine: Gemini + Google Search grounding (FREE
                                         #   default). Free tier grounding exists only on 2.5
                                         #   flash/flash-lite (3.x grounding is paid-tier only),
                                         #   and the per-model request cap binds long before the
                                         #   grounding one: MEASURED 5 RPM / 20 RPD, not the 500
                                         #   RPD advertised. 20/day is ~1 org/day at 10 prompts
                                         #   per product. Empty → engine skipped
AI_VISIBILITY_GEMINI_MODEL=gemini-2.5-flash  # PIN a version, never a `-latest` alias: the free
                                         #   grounding allowance is per MODEL, and the alias
                                         #   drifting onto a generation without one returns 429
                                         #   on every grounded call (outage 13/07→24/07/2026)
AI_VISIBILITY_GEMINI_MODELS=             # optional comma list that SUPERSEDES the single model
                                         #   above. The request cap is per MODEL, so each pinned
                                         #   model is a separate free allowance on the SAME key and
                                         #   the same project (measured 2026-08-01: 2.5-flash,
                                         #   2.5-flash-lite and 3.6-flash each show /20 RPD). A
                                         #   prompt is assigned one model by stable hash and keeps
                                         #   it, because two models disagree about which brands
                                         #   they name and a prompt that changed writer reads as a
                                         #   share-of-voice move. CONFIRM grounding works on a
                                         #   model before adding it (a 429 may just be that day's
                                         #   bucket already spent). Empty → the single model above
AI_VISIBILITY_MODEL_DAILY_BUDGET=18      # HARD code-side ceiling on requests per model per UTC day,
                                         #   enforced by a reservation in ai_visibility_engine_budget
                                         #   before any call leaves. Google states the free-tier
                                         #   ceiling in its own refusal: quotaValue 20, per model,
                                         #   per project. The two left over cover the on-demand
                                         #   "Run now" path, and the fact that a 429 spends a
                                         #   reservation too
AI_VISIBILITY_TEASER_RESERVE=3           # calls per day the drip refuses to schedule, so a signup
                                         #   burst still finds room for its day-0 teaser
PERPLEXITY_API_KEY=                      # engine: Perplexity Sonar (PAID); empty → skipped
AI_VISIBILITY_PERPLEXITY_MODEL=sonar     # Perplexity model (sonar = cheapest search fee)

# Edge cases scraping (patch-23) — pivot/death detection + SPA api capture
PIVOT_DETECTION_MIN_SCRAPES=3            # consecutive snapshots required before confirming a structural change
PIVOT_DETECTION_TEXT_DIFF_THRESHOLD=0.8 # fraction of text that must differ (0-1) to flag a pivot
PIVOT_DETECTION_PHASH_DISTANCE=20       # Hamming distance above which the visual is considered a full redesign
SPA_DETECTION_HTML_MIN_TEXT_LENGTH=500  # below this many chars of visible text, a 200 is a likely pure SPA
SPA_API_CAPTURE_TIMEOUT_MS=15000        # how long to observe XHR/fetch calls when capturing a SPA's API

# Discovery
EXA_API_KEY=
# Short anti-double-click cooldown (seconds) between on-demand Exa discovery runs for the
# SAME target (org+product). NOT a usage cap — cost is bounded by the per-tier monthly
# discoveriesPerMonth quota + the 10/h AI-intensive limit. Was a per-org 30-min block that
# broke the "add product" wizard (a second SKU was refused for 30 min). Default 90.
DETECT_COOLDOWN_SEC=90

# GitHub repo source (self-product `developing` stage). Optional — the scraper reads
# the public REST API unauthenticated (60 req/hr, shared across all github monitors).
# A token lifts that to 5000 req/hr; without it a burst of github scrapes rate-limits.
GITHUB_TOKEN=

# Onboarding latency & background processing (patch-25)
NEXT_PUBLIC_ONBOARDING_PARALLEL_DISCOVERY=true   # prefetch discovery while editing the profile ("false" disables)
NEXT_PUBLIC_ONBOARDING_DISCOVERY_DEBOUNCE_MS=3000 # debounce before the background prefetch (limits Exa spend on edits)
ONBOARDING_RESUME_TTL_DAYS=7                      # how long an unfinished onboarding session stays resumable

# Archive backfill (L2, docs/post-onboarding-activation.md) — on a source's first
# scrape, reconstruct its recent past from the Wayback Machine so day 0 has change
# value. Free (no key), best-effort, in-app only (never emails/Slacks).
BACKFILL_ENABLED=true                             # "false" → no backfill triggered (exact prior behaviour)
BACKFILL_LOOKBACK_DAYS=90                          # how far back the archive-vs-now change is drawn
BACKFILL_SOURCES=homepage,pricing                 # sources whose archive-vs-now diff is meaningful

# Pricing timeline backfill (P5) — the pricing half of the same reconstruction,
# fired by backfill-history on a competitor's first pricing capture. Walks the
# Wayback CDX index (one call) instead of asking the availability API per date,
# samples ~one capture per quarter, and reads each one with the DETERMINISTIC
# harvest first — the AI is a capped fallback for the WHOLE run. Writes
# pricing_history (origin='archive') and nothing else: no change, no signal, no
# summary. Runs once per competitor; a second pass is a manual dev trigger only.
PRICING_BACKFILL_YEARS=3                          # how far back the timeline reaches
PRICING_BACKFILL_MAX_SNAPSHOTS=12                 # hard cap on archived pages fetched per competitor
PRICING_BACKFILL_MAX_AI_CALLS=4                   # AI extractions for the WHOLE backfill; past it a capture is skipped, never half-read
PRICING_BACKFILL_GAP_MS=1500                      # courtesy gap between two fetches to web.archive.org

# Sectoral intelligence (Patch 13) — meso-level trends across an org's own competitors
SECTORAL_ANALYSIS_DAY=monday      # documented only; the Trigger.dev cron is static (Mon 07:00 UTC)
SECTORAL_MIN_COMPETITORS=4        # min active competitors before an org is analyzed
SECTORAL_MIN_CONFIDENCE=0.6       # min pattern confidence (0-1) required to publish a signal

# Upstash Redis — AI cache backend (Patch 09) AND the hard rate limiters
# (anti-OTP-brute-force + anti-AI-abuse). Optional in dev/test (empty → cache and
# rate limiting both no-op). REQUIRED in production: the API fails to boot without
# these when NODE_ENV=production, so rate limiting is never silently disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI
GROQ_API_KEY=             # back-compat: synthesizes a Groq provider if no AI_PROVIDER_N set

# AI provider pool (Patch 22). Legal pool of OpenAI-compatible providers, tried
# free-first then paid. priority = try order (lower first). Numbered contiguously
# AI_PROVIDER_1..N (stops at first gap). dailyTokenQuota is total tokens/day; the
# pool skips a provider at 95% of it. Empty → falls back to GROQ_API_KEY above.
# NOTE: do NOT run multiple Groq accounts (violates Groq ToS) — use distinct providers.
AI_PROVIDER_1_ID=cerebras
AI_PROVIDER_1_BASE_URL=https://api.cerebras.ai/v1
AI_PROVIDER_1_API_KEY=
# Cerebras free tier serves gpt-oss-120b (NOT llama-3.3-70b — that id 404s
# "model_not_found" on this account; verify with GET /v1/models). reasoning_effort
# auto-pins to "low". Same family as Groq's openai/gpt-oss-120b, different id form.
AI_PROVIDER_1_MODEL=gpt-oss-120b
# Optional cheap small (8B-class) model on the SAME endpoint. "fast"-tier tasks
# (classify-change, overlap scoring) route here — ~10× cheaper than the 70B.
# Omit to keep every task on _MODEL. Cerebras free tier has no small model
# (only gpt-oss-120b, zai-glm-4.7), so omit it → fast tasks run on _MODEL.
# AI_PROVIDER_1_FAST_MODEL=
AI_PROVIDER_1_TIER=free
AI_PROVIDER_1_DAILY_TOKEN_QUOTA=1000000
# Tokens per MINUTE, which is the ceiling that actually binds. The daily quota above
# is the one we never reached: measured on prod 2026-07-31, Cerebras served 420k
# tokens in the 05:00 hour, hit its per-minute ceiling, and was gone for the rest of
# the day at 740k of its 1M. Nothing in the pool knew a per-minute limit existed, so
# the hourly fan-out 429'd the one healthy provider, parked it for up to two minutes,
# and dumped everything onto Groq, which is the least able to take it (8k/min).
# Verify yours in the Cerebras dashboard — free-tier limits are per account and have
# moved more than once. 0 disables pacing for this provider (pre-pacing behaviour).
AI_PROVIDER_1_TPM_LIMIT=30000
AI_PROVIDER_1_PRIORITY=1
# Optional, reasoning models only (gpt-oss): low|medium|high. Omit → callLLM auto-
# picks "low" for gpt-oss models (validated cheapest, equal quality) and sends
# nothing for non-reasoning models like Llama. Set only to deviate from "low".
# AI_PROVIDER_1_REASONING_EFFORT=low
# Constrained decoding (Véracité v2 P3). "true" declares that this provider/model
# honours response_format: { type: "json_schema" }. The schema is compiled into the
# decoder, so a malformed reply becomes impossible instead of merely unlikely. Costs
# nothing: same call, same tokens, only the two user-facing generations
# (generate_signal, narrate_change) send a schema.
# DEFAULT OFF, and verify before flipping it per provider: one that advertises the
# field but rejects our schema answers 400, which is the ONE status the pool
# deliberately does not fail over on (a request we built wrong hits every provider
# identically). Unset → the plain json_object mode, byte-identical to today.
# AI_PROVIDER_1_JSON_SCHEMA=true

AI_PROVIDER_2_ID=groq
AI_PROVIDER_2_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_2_API_KEY=
# gpt-oss-120b on Groq: ~4× cheaper input, smarter, cacheable, and validated equal
# quality + JSON adherence vs llama-3.3-70b (src/eval/model-eval.ts). reasoning_effort
# auto-pins to "low". Each provider has its OWN model id (Groq: openai/gpt-oss-120b;
# Cerebras: gpt-oss-120b) — validate per provider before flipping it.
AI_PROVIDER_2_MODEL=openai/gpt-oss-120b
# Groq discontinues llama-3.1-8b-instant + llama-3.3-70b-versatile on 2026-08-16
# (free/developer tiers = ours); gpt-oss-20b is Groq's own recommended replacement
# for the 8b. https://console.groq.com/docs/deprecations
# NB: Cerebras (provider 1) publishes NO small model — only gpt-oss-120b — so it
# declares no FAST_MODEL and a "fast"-tier task falls back to its default there.
AI_PROVIDER_2_FAST_MODEL=openai/gpt-oss-20b
AI_PROVIDER_2_TIER=free
# Groq's free tier serves 200k tokens/DAY per model (and 8k tokens/minute), so the
# 500000 this used to hold was 2.5x a ceiling that does not exist: the pool believed
# it had headroom and kept sending until Groq answered 429. Measured on prod
# 2026-07-31: 231 errors on 401 Groq runs in one day, while Cerebras served 740k
# tokens without a single one. Keep this at the published TPD, never above.
# https://console.groq.com/docs/rate-limits
AI_PROVIDER_2_DAILY_TOKEN_QUOTA=200000
# The other half of the same rate limit, and a DIFFERENT kind of number: the quota
# above is a budget that refills, this is a wall. Groq counts prompt + max_tokens
# against its 8k-per-MINUTE allowance and answers 413 above it, so a task whose
# prompt is structurally bigger can never succeed here however often it is retried.
# Measured on prod over 7 days: 430 such calls, 198 of them `generate_extractor`
# sending ~12k tokens of pruned HTML, every one refused — while Cerebras served the
# same task 206 times. The pool now skips a provider it would exceed instead of
# spending the call (and the failover slot) to be told so. Leave UNSET for a provider
# whose per-request ceiling you have not confirmed: unset means "no ceiling known",
# which is the previous behaviour — attempt it and let the provider answer.
AI_PROVIDER_2_MAX_REQUEST_TOKENS=8000
# These two are different kinds of number and the pool needs both. The one above is
# a WALL: a request bigger than it can never succeed at this provider, however often
# it is retried. The one below is a RATE: a request that fits may still have to wait
# because the minute is already spent. Skipping on size avoids a guaranteed 413;
# pacing on rate avoids the 429 a burst earns.
# Groq's published free per-minute ceiling for gpt-oss-120b, and it counts
# prompt_tokens + max_tokens BEFORE the model runs — which is why a 3.5k prompt
# asking for 6k comes back 413 rather than being served. The estimate the pool books
# against this window includes the output budget for exactly that reason.
AI_PROVIDER_2_TPM_LIMIT=8000
AI_PROVIDER_2_PRIORITY=3

# Cloudflare Workers AI — same gpt-oss weights as Cerebras/Groq, so it is the one
# provider that widens the free envelope without re-running the severity/faithfulness
# evals. Free allocation is 10,000 Neurons/day (Workers Free plan included), and
# gpt-oss-120b costs 31,818 Neurons per 1M input tokens + 68,182 per 1M output: at
# our measured 91.5% input mix that is ~286k tokens/day, or ~527k on the 20b.
# The quota below is expressed in TOKENS (what the pool counts) at the 120b rate, so
# a 20b-heavy day simply leaves Neurons unspent — the safe direction, since running
# out of Neurons mid-day is an error the pool cannot spend its way out of.
# BASE_URL carries the account id (same one as R2_ACCOUNT_ID).
# https://developers.cloudflare.com/workers-ai/platform/pricing/
AI_PROVIDER_3_ID=cloudflare
AI_PROVIDER_3_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
AI_PROVIDER_3_API_KEY=
AI_PROVIDER_3_MODEL=@cf/openai/gpt-oss-120b
AI_PROVIDER_3_FAST_MODEL=@cf/openai/gpt-oss-20b
AI_PROVIDER_3_TIER=free
AI_PROVIDER_3_DAILY_TOKEN_QUOTA=280000
AI_PROVIDER_3_PRIORITY=2
# Per-minute pacing so hasHeadroom is real here: 0 means unpaced, and the interactive
# reserve below does not exist on an unpaced provider. Cloudflare's binding limit is
# the daily Neuron budget, so this mostly steers prompts over ~4.8k tokens to the
# provider with the bigger envelope (Mistral) while small calls stay here.
AI_PROVIDER_3_TPM_LIMIT=6000

# Mistral La Plateforme — free "Experiment" tier: 1 Md tokens/month, 1 req/s, 500k
# tokens/minute. By far the biggest free envelope on offer, and the only EU-hosted
# one, but a DIFFERENT model family: it must clear `eval:severity` and
# `eval:faithfulness` before it is allowed to carry classify, hence the last free
# priority. Two manual steps before enabling: (1) opt out of model training in
# Admin Console > Privacy (free-tier inputs feed Mistral's training programs BY
# DEFAULT since 2026-03-12), (2) pin the dated model id returned by GET /v1/models,
# never a `-latest` alias — an alias that slides onto a generation without free
# quota is exactly how the Gemini grounding outage happened (13/07 to 24/07/2026).
AI_PROVIDER_4_ID=mistral
AI_PROVIDER_4_BASE_URL=https://api.mistral.ai/v1
AI_PROVIDER_4_API_KEY=
AI_PROVIDER_4_MODEL=
AI_PROVIDER_4_FAST_MODEL=
AI_PROVIDER_4_TIER=free
AI_PROVIDER_4_DAILY_TOKEN_QUOTA=30000000
AI_PROVIDER_4_PRIORITY=4
# Mistral's published free limit is 1 request/second, which the pool cannot count (it
# paces tokens, not requests). 60k TPM at ~3.3k tokens per call keeps the background
# fleet near 0.25 req/s and leaves 12k/min to the interactive reserve.
AI_PROVIDER_4_TPM_LIMIT=60000

# Share of every provider's per-minute ceiling (AI_PROVIDER_N_TPM_LIMIT) that only
# INTERACTIVE work may draw on: an Ask question, a signals brief, anything a person
# is watching. Background work — the hourly fan-out, extraction, classification — is
# held to the remaining 80%. Without it the fleet and the person at the screen drew
# from the same pot and the fleet is always first, which is why a SOLO tester saw
# "AI insights are delayed" while nothing was actually broken. A call is marked
# interactive by its withAiContext scope, and nested scopes inherit it, so a job the
# user is watching wraps its body once. 0 disables the reserve.
AI_INTERACTIVE_RESERVE_FRACTION=0.2

# How long a JOB waits after the AI pool refused it, before the queue runs it again.
# The queue's own retry policy is 1s backing off to at most 10s, which is right for a
# transient fault and exactly wrong for a rate limit: the free tiers answer a 429
# asking for 18 to 60 seconds, so all three attempts land inside the window that is
# still throttled and the job fails having spent two extra rounds of provider calls to
# learn nothing. Measured over 7 days on prod: 333 extract_pricing AI calls for 184
# pricing pages that had actually changed. Only AIUnavailableError defers, and not
# when the pool is misconfigured or the request is too large — neither heals by
# waiting, so both keep the retry policy and end up in the dead-letter queue where
# someone sees them. Must outlive the longest per-provider park (120 s, see
# rateLimitBackoffSec): 75 s never did.
AI_DEFER_BASE_SEC=150
# One-sided spread on that wait, as a fraction of the base. Without it every job the
# same outage deferred comes back at the same instant and rebuilds the burst that
# caused the outage, one window later. Never earlier than the base: coming back early
# is the one outcome that cannot help.
AI_DEFER_JITTER_FRACTION=0.6
# Deferrals a single job may accumulate before it falls back to the normal retry
# policy (and from there to the dead-letter queue). A bound, not a tuning knob: a
# permanently unavailable pool must not reschedule a job forever, because a job that
# never fails is a job nobody is told about. 5 x 150-240 s is a 750-1200 s horizon,
# which outlives the 2-minute global breaker below; 3 x 75-105 s never outlived the
# old 10-minute one, and 86% of deferred jobs died inside it (2026-09-03).
QUEUE_MAX_DEFERRALS=5

# Circuit breaker (Patch 22): global trip after N exhausted tasks in a rolling 10 min,
# and the default park of a provider that answered 401/402/403/404. Threshold 20 because
# 5 exhausted tasks is a few seconds of the :00 burst at 12-22 calls/min, not an
# outage; reset 2 min so a blackout is shorter than the deferral horizon above.
AI_CIRCUIT_BREAKER_THRESHOLD=20
AI_CIRCUIT_BREAKER_RESET_MIN=2

# Hard anti-abuse rate limit (patch-22) — discretionary AI actions per user per window.
# The per-window ceiling is PER TIER since 2026-07-31 (PLAN_LIMITS.aiActionsPerHour:
# 20/40/120/300). AI_INTENSIVE_RATE_LIMIT is now a SINGLE-VALUE emergency override that
# re-flattens every tier onto one number — leave it UNSET in normal operation, or the
# old flat 10 silently comes back for business as well as free.
# AI_INTENSIVE_RATE_LIMIT=
AI_INTENSIVE_WINDOW_SEC=3600

# Bounded concurrency for the competitor-summary queue. Onboarding fires every
# competitor's homepage scrape at once, so refresh-competitor-summary fans out
# N-wide; serialising to a few at a time keeps each AI call from throttling the
# shared provider pool (one summary used to stall ~56s or time out). Raise on a
# paid AI tier with more headroom.
SUMMARY_CONCURRENCY=3

# AI cache TTLs in days (Patch 09 — deterministic tasks only)
AI_CACHE_TTL_CLASSIFY_DAYS=7
AI_CACHE_TTL_ANALYZE_DAYS=30
AI_CACHE_TTL_SCORE_DAYS=30

# Anti-hallucination (Patch 24 — grounding + self-check + transparency)
GROUNDING_VALIDATION_ENABLED=true          # validate AI citations against the source text
GROUNDING_FUZZY_MATCH_THRESHOLD=0.85       # fuzzy-match threshold for a citation to count as grounded
SELF_CHECK_BATTLE_CARDS=true               # always run a 2nd-pass self-check on battle cards
SELF_CHECK_SAMPLING_RATE=0                 # fraction of other outputs sampled for a self-check (0 = off; battle cards + low-confidence still checked)
CONFIDENCE_DOT_THRESHOLD=high              # show the ConfidenceDot only when confidence < this (high|medium)
AI_HALLUCINATION_ALERT_RATE=0.03           # Slack ops alert if a task's hallucination rate exceeds this over 7d
# Mirrored to the web bundle for the ConfidenceDot visibility rule + ops metric highlight:
NEXT_PUBLIC_CONFIDENCE_DOT_THRESHOLD=high
NEXT_PUBLIC_AI_HALLUCINATION_ALERT_RATE=0.03

# Claim-level faithfulness gate — the high-stakes outputs (battle cards, weekly
# digests, critical/high signal insights) are decomposed into atomic claims, each
# verified against its cited source with the SAME fuzzy validator above, and the
# undecided ones settled by a binary judge (both calls on the pool's FAST model).
# Below the ratio, or on any claim judged unfaithful, the output is NOT published
# (no email, no Slack, no battle card written) and lands in /admin/ai-review-queue.
# Fails OPEN: a parse miss / rate limit / open breaker publishes unverified.
# OPT-IN: unset/anything but "true" → the chain never runs, nothing is ever blocked
# (exact pre-gate behaviour, zero added AI calls). Enable only where the provider
# pool is healthy AND `pnpm --filter @outrival/ai eval:faithfulness` has passed —
# the judge's false-block rate is a model property, not a code property.
FAITHFULNESS_GATE_ENABLED=false
FAITHFULNESS_MIN_RATIO=0.9                 # min supported/total claims for an output to publish
# Per-task scope (P5, decided by docs/faithfulness-rollout.md). Comma-separated,
# from: battle_card | digest | signal_insight. Set on the WORKER service only —
# the gate never runs anywhere else. A non-blank value WINS over the boolean
# above, both ways: it enables a task the boolean leaves off, and it keeps every
# unlisted task off even when the boolean is "true". So the kill switch is
# unsetting this line, not flipping the boolean. An unrecognised name gates
# nothing (a typo must fail towards publishing).
# Recommended first rollout: battle_card,digest — a false block there defers a
# recoverable output, where a false block on a critical alert cannot be undone.
FAITHFULNESS_GATE_TASKS=

# Email
RESEND_API_KEY=
CONTACT_EMAIL=                       # inbox for landing /demo lead-form submissions (default hello@outrival.app)

# Notification moderation (patch-26)
NOTIFICATION_DAILY_EMAIL_CAP=10      # max immediate emails/day per org (critical bypasses)
NOTIFICATION_CRITICAL_BYPASS=true    # critical severity ignores every filter
QUIET_HOURS_DEFAULT_START=22         # default quiet-hours start, 0-23 org-local
QUIET_HOURS_DEFAULT_END=8            # default quiet-hours end, 0-23 org-local
QUIET_HOURS_WEEKEND_OFF=true         # mute Sat+Sun by default
RELEVANCE_THRESHOLD_DEFAULT=0.5      # default per-org relevance threshold (0-1)
RELEVANCE_AUTO_ADJUST_MIN_FEEDBACKS=10 # min org feedbacks before auto-adjusting the threshold
RELEVANCE_RECALC_INTERVAL_HOURS=168  # threshold recalc cadence (weekly = 7*24)
BATCHING_WINDOW_HOURS=24             # window for grouping similar signals
BATCHING_MIN_SIGNALS=3               # min similar signals to form a batch
BATCHING_MAX_GROUPS=500              # max groups batched per run (one AI call each)

# Stale-data actions (patch-27)
# Per-source-type freshness thresholds "yellow,orange,red" in days. Server-side
# only (the web dot uses these defaults). Categories: github_repo→features.
STALENESS_THRESHOLDS_PRICING=7,14,30
STALENESS_THRESHOLDS_FEATURES=14,30,60
STALENESS_THRESHOLDS_REVIEWS=21,45,90
STALENESS_THRESHOLDS_JOBS=14,30,60
STALENESS_THRESHOLDS_BLOG=30,60,120
STALENESS_THRESHOLDS_HOMEPAGE=14,30,60
# User-forced re-scan daily limit per tier (counted per user). Optional override of
# PLAN_LIMITS defaults (tier-limits 2026-06-04: business is a real 100 cap, not unlimited).
FORCED_RESCAN_LIMIT_FREE=1
FORCED_RESCAN_LIMIT_STARTER=5
FORCED_RESCAN_LIMIT_PRO=20
FORCED_RESCAN_LIMIT_BUSINESS=100
# Ops + user alert when an active monitor has produced no signal for this long.
SILENT_MONITOR_ALERT_THRESHOLD_DAYS=60
# Auto re-arm of monitors paused as unscrapable (3 consecutive failures pause them
# via isActive:false). schedule-scraping re-probes such a monitor once every N days
# so a transient outage no longer kills it permanently; a fresh failure re-pauses it.
UNSCRAPABLE_REARM_DAYS=7

# Self-product multi-SKU (patch-28)
# Max active products (SKUs) per org by plan tier. One product = the classic
# single self-product flow (transparent for mono-product users).
PRODUCT_LIMIT_FREE=1
PRODUCT_LIMIT_STARTER=2
PRODUCT_LIMIT_PRO=5
PRODUCT_LIMIT_BUSINESS=999

# Payments (Stripe — Phase 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (build-time, safe to expose) — powers the in-app Payment Element
# used to update the card on file. Empty → the "Update payment method" dialog degrades
# to a config notice; the rest of billing (Checkout redirect) still works.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Frontend
NEXT_PUBLIC_API_URL=       # https://api.outrival.app
# Where the NEXT SERVER (not the browser) reaches the API. Runtime env on the `web`
# service, deliberately NOT a NEXT_PUBLIC_ name, because the browser can neither
# resolve nor use it. Unset → falls back to NEXT_PUBLIC_API_URL, i.e. the previous behaviour.
#
# Why it exists: a dashboard render fires 8-14 server-side API calls (layout gate,
# shell widgets, page seeds). Sent to the public hostname, each one leaves the VPS,
# crosses Cloudflare and comes back in through Traefik. That is a full internet round
# trip to a container on the same host, paid 8-14 times per navigation. Point this at the
# API directly and that hop disappears.
#   Coolify: enable "Connect to Predefined Network" on BOTH apps → http://api:3001
#   (use the api service's container name), or the host-published port if you have one.
# Verify after setting it: the web container must be able to curl <value>/health.
INTERNAL_API_URL=          # http://api:3001
WEB_URL=                   # https://outrival.app — used by Stripe success/cancel URLs
# Build provenance (Docker BUILD ARGS for @outrival/web, not runtime env) — inlined
# at `next build`; surfaced by GET /api/version to tell which commit is live.
# In Coolify: pass GIT_SHA as a build variable (its SOURCE_COMMIT). Default "unknown".
GIT_SHA=                   # deploying commit sha (build arg)
BUILD_TIME=                # build timestamp, e.g. 2026-07-04T17:00:00Z (build arg)

# Observability (Patch 04)
LOG_LEVEL=info             # debug | info | warn | error
SENTRY_DSN_API=
SENTRY_DSN_WORKERS=
SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN=    # mirror of SENTRY_DSN_WEB (exposed to the browser)
SENTRY_AUTH_TOKEN=         # source maps upload (build-time)
SENTRY_ORG=
SENTRY_PROJECT_WEB=outrival-web
# Optional log shipping (deferred)
AXIOM_TOKEN=
AXIOM_DATASET=outrival

# Analytics (Patch 03 — PostHog Cloud EU)
NEXT_PUBLIC_POSTHOG_KEY=        # phc_... (project API key, same as POSTHOG_API_KEY)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_API_KEY=                # phc_... (server-side, same project key)
POSTHOG_HOST=https://eu.i.posthog.com

# Feedback widget (Patch 05) — Slack webhook ops (perso, distinct des webhooks org)
OPS_SLACK_WEBHOOK_URL=

# Admin ops (Patch 02) — comma-separated allowlist of operator emails. Gates the
# /admin dashboard and /api/admin/* routes. NOT the org "owner" role.
ADMIN_EMAILS=

# Quality feedback loop (Patch 21) — both optional, sensible defaults shown.
FEEDBACK_NPS_INTERVAL_DAYS=30    # min days between NPS prompts for the same user
FEEDBACK_NPS_MIN_ACCOUNT_AGE_DAYS=14  # never ask before the account is this old — right
                                 # out of onboarding the user is scoring the signup flow,
                                 # not the product, and the one prompt per interval is spent
FEEDBACK_NPS_MIN_SIGNALS=3       # min signals in the org before asking (proof there is
                                 # something to score). 0 disables this gate
FEEDBACK_AGGREGATE_MIN_COUNT=5   # min feedbacks before a pattern is surfaced in /admin
