next-env.d.ts

# Crawlee runtime cache (regenerated; never source)
storage/

# Global Impeccable plugin (auto-installed into .claude/, not Outrival source)
.claude/skills/impeccable/
.claude/agents/impeccable-manual-edit-applier.md
# Impeccable-generated design "registers" doc (regenerated; not committed here)
PRODUCT.md
.design-review/

# Playwright MCP scratch (screenshots/snapshots; never source)
.playwright-mcp/

# Orca drop staging (source-asset scratch; the processed assets live in public/)
.orca/

# Local git worktrees created by Claude Code agents
.claude/worktrees/

# Prompts déposés par claude-board avant lancement d'une session
.claude-board/

# Un worktree créé depuis Windows (Warp) écrit son chemin `C:\...` LITTÉRALEMENT
# dans le FS WSL, donc un repo entier apparaît à la racine sous ce nom. Le nettoyage
# est `git worktree remove`, pas un rm : il reste enregistré tant qu'on ne le fait pas.
C:\\*

# Audit mailbox credentials are env-only (scripts/poll-inbox.ts reads AUDIT_IMAP_*).
audit/**/*.local

# GeoNames dumps cached by packages/shared/scripts/build-geo-dataset.ts. Build-time
# input only — the committed output is src/geo/dataset.generated.ts.
packages/shared/scripts/.geo-cache/
