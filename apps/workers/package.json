{
  "name": "@outrival/workers",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/queue/worker.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 60000 test/",
    "queue:dev": "bun run --hot src/queue/worker.ts",
    "queue:start": "bun run src/queue/worker.ts",
    "backfill:hiring-geo": "bun run src/scripts/backfill-hiring-geo.ts",
    "backfill:salary-bands": "bun run src/scripts/backfill-salary-bands.ts",
    "backfill:content-dates": "bun run src/scripts/backfill-content-dates.ts",
    "backfill:messaging": "bun run src/scripts/backfill-messaging-versions.ts",
    "backfill:named-competitors": "bun run src/scripts/backfill-named-competitors.ts",
    "ats:coverage": "bun run src/scripts/ats-coverage.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@outrival/ai": "workspace:*",
    "@outrival/db": "workspace:*",
    "@outrival/queue": "workspace:*",
    "@outrival/scrapers": "workspace:*",
    "@outrival/shared": "workspace:*",
    "@sentry/esbuild-plugin": "^5.3.0",
    "@sentry/node": "^10.54.0",
    "drizzle-orm": "^0.45.2",
    "playwright": "^1.60.0",
    "posthog-node": "^5.35.5",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@types/node": "^25.9.1"
  }
}
