# /opt/outrival/.env.worker — loaded by BOTH worker services (env_file).
# Real file is 0600, deploy-owned, and NEVER committed. This lists the keys that
# must exist; values live only on the box.
#
# WORKER_ROLE is deliberately absent: it is set per-service in
# docker-compose.override.yml, because the two workers share this file and must
# NOT share a role.

# --- queue -------------------------------------------------------------------
# Dedicated always-on Postgres on this box, reached over the internal bridge
# network (host `postgres`), never Neon. The API uses the same credential but
# over the tunnel: postgres://outrival:<pw>@10.10.0.1:5432/outrival_queue
QUEUE_DATABASE_URL=

# --- relational DB -----------------------------------------------------------
DATABASE_URL=

# --- dead-man's switch -------------------------------------------------------
# External heartbeat monitor (Better Stack / UptimeRobot). The light worker GETs
# it every 5 min; the monitor alerts when the pings STOP. Empty → the job no-ops
# and NO dead-man switch is active — a state that looks healthy and is not.
HEARTBEAT_URL=

# --- AI ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
GROQ_API_KEY=
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_RESET_MIN=10

# --- rate limiting / cache ---------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- scraping ----------------------------------------------------------------
PROXYSCRAPE_DC_ENDPOINT=
PROXYSCRAPE_DC_USERNAME=
PROXYSCRAPE_DC_PASSWORD=
EXA_API_KEY=
# scrape-monitor jobs in flight on the browser worker (shared 8 GB box, not
# Trigger's per-run machines).
SCRAPE_CONCURRENCY=3
SUMMARY_CONCURRENCY=1

# --- notifications / ops -----------------------------------------------------
RESEND_API_KEY=
OPS_SLACK_WEBHOOK_URL=
SENTRY_DSN_WORKERS=
POSTHOG_API_KEY=

# --- misc --------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
WEB_URL=
NEXT_PUBLIC_API_URL=
