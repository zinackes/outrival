# /opt/outrival/.env.worker — loaded by BOTH worker services (env_file).
# Real file is 0600, deploy-owned, and NEVER committed. This lists the keys that
# must exist; values live only on the box.
#
# WORKER_ROLE is deliberately absent: it is set per-service in
# docker-compose.override.yml, because the two workers share this file and must
# NOT share a role.

# --- queue -------------------------------------------------------------------
# Dedicated always-on Postgres on this box, reached over the internal bridge
# network (host `postgres`), never Neon. The API uses the same credential but
# over the tunnel: postgres://outrival:<pw>@10.10.0.1:5432/outrival_queue
QUEUE_DATABASE_URL=

# --- relational DB -----------------------------------------------------------
DATABASE_URL=

# --- dead-man's switch -------------------------------------------------------
# External heartbeat monitor (Better Stack / UptimeRobot). The light worker GETs
# it every 5 min; the monitor alerts when the pings STOP. Empty → the job no-ops
# and NO dead-man switch is active — a state that looks healthy and is not.
HEARTBEAT_URL=

# --- AI ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Back-compat only: loadProviders() falls back to a single synthesized Groq
# provider when no AI_PROVIDER_* is set. That fallback is a ONE-provider pool with
# no failover — always configure the block below instead.
GROQ_API_KEY=
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_RESET_MIN=10

# Provider pool, tried free-first by priority. Read as AI_PROVIDER_1..N, CONTIGUOUS
# — loadProviders() skips an entry missing ID/API_KEY/BASE_URL, so a blank key
# silently drops that provider from the pool.
#
# The models are not interchangeable, and getting one wrong is not a degraded pool
# but an outage: on 2026-07-22 this file's real counterpart carried
# AI_PROVIDER_1_MODEL=llama-3.3-70b, which Cerebras 404s (model_not_found). Every
# call to p1 failed as a CONFIG error, Groq absorbed 100% of the load and started
# rate-limiting, and each window where Groq sat in its breaker left Cerebras as the
# only pickable provider — so the pool exhausted on config errors alone, tripping
# the GLOBAL breaker on the spot (provider.ts:205) and blanking AI workspace-wide,
# in a loop. Cerebras serves gpt-oss-120b, gemma-4-31b, zai-glm-4.7 — nothing else.
AI_PROVIDER_1_ID=cerebras
AI_PROVIDER_1_BASE_URL=https://api.cerebras.ai/v1
AI_PROVIDER_1_API_KEY=
AI_PROVIDER_1_MODEL=gpt-oss-120b
AI_PROVIDER_1_TIER=free
AI_PROVIDER_1_DAILY_TOKEN_QUOTA=1000000
AI_PROVIDER_1_PRIORITY=1
# No AI_PROVIDER_1_FAST_MODEL: Cerebras exposes no small model, so tier:"fast"
# tasks fall back to this provider's default model when they land here.
AI_PROVIDER_2_ID=groq
AI_PROVIDER_2_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_2_API_KEY=
AI_PROVIDER_2_MODEL=openai/gpt-oss-120b
# Carries every tier:"fast" task (classify-change, overlap scoring, the cosmetic
# gate) — the highest-volume AI traffic we have. Leaving it unset routes all of it
# to the 120b, which is what pushes Groq into its rate limit.
AI_PROVIDER_2_FAST_MODEL=openai/gpt-oss-20b
AI_PROVIDER_2_TIER=free
# Groq's published free ceiling is 200k tokens/DAY per model. This held 500000, so
# the pool spent the last 300k of every day discovering the limit by 429 (231 errors
# on 401 Groq runs, prod 2026-07-31). Never set this above the published TPD.
AI_PROVIDER_2_DAILY_TOKEN_QUOTA=200000
AI_PROVIDER_2_PRIORITY=3
# Cloudflare Workers AI — the SAME gpt-oss weights, so it widens the free envelope
# with no model re-eval. 10,000 Neurons/day free; at our 91.5%-input mix that is
# ~286k tokens/day on the 120b. Quota below is in tokens at the 120b Neuron rate.
# The account id in the URL is the one already in R2_ACCOUNT_ID.
AI_PROVIDER_3_ID=cloudflare
AI_PROVIDER_3_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
AI_PROVIDER_3_API_KEY=
AI_PROVIDER_3_MODEL=@cf/openai/gpt-oss-120b
AI_PROVIDER_3_FAST_MODEL=@cf/openai/gpt-oss-20b
AI_PROVIDER_3_TIER=free
AI_PROVIDER_3_DAILY_TOKEN_QUOTA=280000
AI_PROVIDER_3_PRIORITY=2
# Mistral La Plateforme free tier: 1 Md tokens/month, 1 req/s. Biggest free envelope
# and EU-hosted, but a different model family: it stays at the last free priority
# until eval:severity and eval:faithfulness pass. Opt out of training in Admin
# Console > Privacy first (free-tier inputs feed training by default), and pin a
# DATED model id from GET /v1/models, never a `-latest` alias.
AI_PROVIDER_4_ID=mistral
AI_PROVIDER_4_BASE_URL=https://api.mistral.ai/v1
AI_PROVIDER_4_API_KEY=
AI_PROVIDER_4_MODEL=
AI_PROVIDER_4_FAST_MODEL=
AI_PROVIDER_4_TIER=free
AI_PROVIDER_4_DAILY_TOKEN_QUOTA=30000000
AI_PROVIDER_4_PRIORITY=4
# There is no paid floor configured. Once every free provider is exhausted or
# breakered, AI stops until the daily quotas reset.
# Claim-level faithfulness gate. OPT-IN: anything but "true" leaves it inert (no
# added AI calls, nothing ever withheld). Turn it on only once the provider pool is
# healthy and `pnpm --filter @outrival/ai eval:faithfulness` has passed — enabled,
# it can withhold a battle card, a digest email or a critical alert.
FAITHFULNESS_GATE_ENABLED=false
FAITHFULNESS_MIN_RATIO=0.9

# --- rate limiting / cache ---------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- scraping ----------------------------------------------------------------
PROXYSCRAPE_DC_ENDPOINT=
PROXYSCRAPE_DC_USERNAME=
PROXYSCRAPE_DC_PASSWORD=
EXA_API_KEY=
# scrape-monitor jobs in flight on the browser worker (shared 8 GB box, not
# Trigger's per-run machines).
SCRAPE_CONCURRENCY=3
SUMMARY_CONCURRENCY=1

# --- notifications / ops -----------------------------------------------------
RESEND_API_KEY=
OPS_SLACK_WEBHOOK_URL=
SENTRY_DSN_WORKERS=
POSTHOG_API_KEY=

# --- misc --------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
WEB_URL=
NEXT_PUBLIC_API_URL=
