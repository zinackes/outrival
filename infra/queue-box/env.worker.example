# /opt/outrival/.env.worker — loaded by BOTH worker services (env_file).
# Real file is 0600, deploy-owned, and NEVER committed. This lists the keys that
# must exist; values live only on the box.
#
# WORKER_ROLE is deliberately absent: it is set per-service in
# docker-compose.override.yml, because the two workers share this file and must
# NOT share a role.

# --- queue -------------------------------------------------------------------
# Dedicated always-on Postgres on this box, reached over the internal bridge
# network (host `postgres`), never Neon. The API uses the same credential but
# over the tunnel: postgres://outrival:<pw>@10.10.0.1:5432/outrival_queue
QUEUE_DATABASE_URL=
# Deferrals one job may accumulate before it falls back to the normal retry policy
# and from there to the dead-letter queue. A bound, not a knob: an indefinitely
# unavailable pool would otherwise reschedule a job forever, and a job that never
# fails is a job nobody is told about.
QUEUE_MAX_DEFERRALS=3

# --- relational DB -----------------------------------------------------------
DATABASE_URL=

# --- dead-man's switch -------------------------------------------------------
# External heartbeat monitor (Better Stack / UptimeRobot). The light worker GETs
# it every 5 min; the monitor alerts when the pings STOP. Empty → the job no-ops
# and NO dead-man switch is active — a state that looks healthy and is not.
HEARTBEAT_URL=

# --- AI ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Back-compat only: loadProviders() falls back to a single synthesized Groq
# provider when no AI_PROVIDER_* is set. That fallback is a ONE-provider pool with
# no failover — always configure the block below instead.
GROQ_API_KEY=
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_RESET_MIN=10
# Process-wide ceiling on simultaneous calls to the pool. The only brake that acts
# BEFORE a 429; the breakers and the TPM windows are all reactions to one. Drop it to
# 1 when a single provider with a per-REQUEST limit is carrying the pool alone, which
# is what Mistral's 1 req/s makes of any day where the others are quota-exhausted.
AI_MAX_CONCURRENT_CALLS=4
# How long a job waits after the pool refused it. The queue's retry policy (1s to
# 10s) is right for a transient fault and exactly wrong for a rate limit: the free
# tiers answer a 429 asking for 18 to 60 seconds, so all three attempts land inside
# the window that is still throttled. Raise it, not the retry count, when the pool
# is the thing that is failing.
AI_DEFER_BASE_SEC=75
# Spread, as a fraction of the base, one-sided (never earlier). Without it every job
# the same outage deferred comes back at the same instant and rebuilds the burst.
AI_DEFER_JITTER_FRACTION=0.4

# Provider pool, tried free-first by priority. Read as AI_PROVIDER_1..10; a slot
# missing ID/API_KEY/BASE_URL is skipped and the loader keeps going, so a gap costs
# only its own slot. Slot 1 is empty since Cerebras was retired on 2026-09-04 (no
# credit since 2026-08-17); leaving the hole is deliberate, renumbering the rest buys
# nothing and risks a typo on a live box.
#
# The models are not interchangeable, and getting one wrong is not a degraded pool
# but an outage: on 2026-07-22 this file's real counterpart named a model the provider
# 404s (model_not_found). Every call to that slot failed as a CONFIG error, Groq
# absorbed 100% of the load and started rate-limiting, and each window where Groq sat
# in its breaker left the misconfigured provider as the only pickable one — so the
# pool exhausted on config errors alone, tripping the GLOBAL breaker on the spot and
# blanking AI workspace-wide, in a loop.
AI_PROVIDER_2_ID=groq
AI_PROVIDER_2_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_2_API_KEY=
AI_PROVIDER_2_MODEL=openai/gpt-oss-120b
# Carries every tier:"fast" task (classify-change, overlap scoring, the cosmetic
# gate) — the highest-volume AI traffic we have. Leaving it unset routes all of it
# to the 120b, which is what pushes Groq into its rate limit.
AI_PROVIDER_2_FAST_MODEL=openai/gpt-oss-20b
AI_PROVIDER_2_TIER=free
# Groq's published free ceiling is 200k tokens/DAY per model. This held 500000, so
# the pool spent the last 300k of every day discovering the limit by 429 (231 errors
# on 401 Groq runs, prod 2026-07-31). Never set this above the published TPD.
AI_PROVIDER_2_DAILY_TOKEN_QUOTA=200000
AI_PROVIDER_2_PRIORITY=3
# Groq publishes 8,000 tokens/min. Unset is not "no limit at the provider", it is no
# limit HERE: provider-pool.ts reads a missing value as 0 and 0 disables pacing, so
# the pool bursts straight into a 429 storm the moment Groq carries the load alone.
AI_PROVIDER_2_TPM_LIMIT=8000
AI_PROVIDER_2_MAX_REQUEST_TOKENS=8000
# Cloudflare Workers AI — the SAME gpt-oss weights, so it widens the free envelope
# with no model re-eval. 10,000 Neurons/day free; at our 91.5%-input mix that is
# ~286k tokens/day on the 120b. Quota below is in tokens at the 120b Neuron rate.
# The account id in the URL is the one already in R2_ACCOUNT_ID.
AI_PROVIDER_3_ID=cloudflare
AI_PROVIDER_3_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
AI_PROVIDER_3_API_KEY=
AI_PROVIDER_3_MODEL=@cf/openai/gpt-oss-120b
AI_PROVIDER_3_FAST_MODEL=@cf/openai/gpt-oss-20b
AI_PROVIDER_3_TIER=free
AI_PROVIDER_3_DAILY_TOKEN_QUOTA=280000
AI_PROVIDER_3_PRIORITY=2
AI_PROVIDER_3_TPM_LIMIT=6000
# Mistral La Plateforme free tier: 1 Md tokens/month, 1 req/s. Biggest free envelope
# and EU-hosted, but a different model family: it stays at the last free priority
# until eval:severity and eval:faithfulness pass. Opt out of training in Admin
# Console > Privacy first (free-tier inputs feed training by default), and pin a
# DATED model id from GET /v1/models, never a `-latest` alias.
AI_PROVIDER_4_ID=mistral
AI_PROVIDER_4_BASE_URL=https://api.mistral.ai/v1
AI_PROVIDER_4_API_KEY=
AI_PROVIDER_4_MODEL=mistral-medium-2604
AI_PROVIDER_4_FAST_MODEL=mistral-small-2603
AI_PROVIDER_4_TIER=free
AI_PROVIDER_4_DAILY_TOKEN_QUOTA=30000000
AI_PROVIDER_4_PRIORITY=4
AI_PROVIDER_4_TPM_LIMIT=60000
# There is no paid floor configured. Once every free provider is exhausted or
# breakered, AI stops until the daily quotas reset.
# Claim-level faithfulness gate. OPT-IN: anything but "true" leaves it inert (no
# added AI calls, nothing ever withheld). Turn it on only once the provider pool is
# healthy and `pnpm --filter @outrival/ai eval:faithfulness` has passed — enabled,
# it can withhold a battle card, a digest email or a critical alert.
FAITHFULNESS_GATE_ENABLED=false
FAITHFULNESS_MIN_RATIO=0.9

# --- AI visibility -----------------------------------------------------------
# Separate from the provider pool above: these query the ANSWER ENGINES themselves
# to measure how visible a product is in them, so they are not interchangeable with
# a pool slot. Unset → the gemini engine is skipped with a warning and the run
# reports on whatever engines remain.
GEMINI_API_KEY=
# Pin a DATED model, never a `-latest` alias: an alias drifts onto a generation with
# no free tier (outage 13/07 to 24/07/2026). `AI_VISIBILITY_GEMINI_MODELS` (plural)
# takes precedence and accepts a comma-separated list; the per-model request cap is
# applied per entry.
AI_VISIBILITY_GEMINI_MODEL=gemini-2.5-flash

# --- rate limiting / cache ---------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- storage (R2) ------------------------------------------------------------
# BOOT-BLOCKING: apps/workers/src/env.ts requires all four before a single handler
# is registered. They were absent from this file until 2026-09-04 (audit, P-09),
# so a box provisioned from the template alone never booted. HTML snapshots and
# every binary asset live here, never in Postgres.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- security ----------------------------------------------------------------
# AES-256-GCM key (32 bytes, 64 hex chars) decrypting the CRM destination signing
# secrets at rest. Must be the SAME value as the API's. Unset → an encrypted
# destination is skipped with a logged error rather than pushed unsigned.
OAUTH_TOKEN_ENCRYPTION_KEY=

# --- scraping ----------------------------------------------------------------
PROXYSCRAPE_DC_ENDPOINT=
PROXYSCRAPE_DC_USERNAME=
PROXYSCRAPE_DC_PASSWORD=
EXA_API_KEY=
# scrape-monitor jobs in flight on the browser worker (shared 8 GB box, not
# Trigger's per-run machines).
SCRAPE_CONCURRENCY=3
SUMMARY_CONCURRENCY=1
# Kill switch for cascade level 1 (browser render via datacenter egress). Only
# "false" disables it; anything else, unset included, leaves it on. It also needs a
# configured datacenter egress above, so it is already inert without one.
SCRAPING_LEVEL_1_ENABLED=true
# Ceiling on the HTML handed to the extractors after pruning. It is a COST knob:
# every character above it is tokens the pool spends on boilerplate.
PRUNE_HTML_MAX_CHARS=40000

# --- notifications / ops -----------------------------------------------------
RESEND_API_KEY=
OPS_SLACK_WEBHOOK_URL=
SENTRY_DSN_WORKERS=
POSTHOG_API_KEY=

# --- misc --------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
WEB_URL=
NEXT_PUBLIC_API_URL=
