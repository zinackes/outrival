{
  "name": "outrival",
  "private": true,
  "scripts": {
    "dev": "trap 'kill 0' EXIT; stripe listen --forward-to http://localhost:3001/api/stripe/webhook & turbo dev",
    "dev:app": "turbo dev --filter @outrival/web --filter @outrival/api",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "check:lint": "oxlint apps packages",
    "check:contrast": "pnpm --filter @outrival/web check:contrast",
    "test": "turbo test",
    "test:local": "turbo test --concurrency=1",
    "test:fast": "turbo test --concurrency=1 --filter=...[origin/main]",
    "check:metadata": "bun scripts/check-metadata.ts",
    "backfill:hiring-geo": "pnpm --filter @outrival/workers backfill:hiring-geo",
    "backfill:salary-bands": "pnpm --filter @outrival/workers backfill:salary-bands",
    "db:push": "pnpm --filter @outrival/db db:push",
    "db:generate": "pnpm --filter @outrival/db db:generate",
    "db:migrate": "pnpm --filter @outrival/db db:migrate",
    "db:baseline": "pnpm --filter @outrival/db db:baseline",
    "db:realign-journal": "pnpm --filter @outrival/db db:realign-journal",
    "db:studio": "pnpm --filter @outrival/db db:studio"
  },
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "oxlint": "^1.77.0",
    "turbo": "latest",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.0",
      "brace-expansion": "^5.0.9",
      "browserslist": "^4.28.7",
      "fast-uri": "^3.1.6",
      "js-yaml": "^3.15.1",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "undici": "^7.29.0"
    },
    "auditConfig": {
      "ignoreGhsas": []
    }
  }
}
